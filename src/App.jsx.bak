const initialCalendarEvents = {
  '2026-08-23': [
    { type: 'violation', desc: 'VIO-00123: Critical deviation on LG 65" C4 on Amazon.' }
  ],
  '2026-08-24': [
    { type: 'violation', desc: 'VIO-00122: High deviation on LG 75" QNED on Best Buy.' }
  ],
  '2026-08-17': [
    { type: 'rule', desc: 'Promo Launch: Temporary C4 OLED allowances activate.' }
  ],
  '2026-08-25': [
    { type: 'exception', desc: 'Promo Expired: Allowed C4 window closes.' }
  ]
};

const monthNames = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October", "November", "December"];

export default function App() {
  // --------------------------------------------------------------------------
  // SCREEN STATES: 'login', 'client-select', 'app'
  // --------------------------------------------------------------------------
  const [screen, setScreen] = useState('login');
  const [selectedClient, setSelectedClient] = useState('LG');
  const [currentView, setCurrentView] = useState('dashboard');
  
  // Subtabs state matching tabs of mosaic screens
  const [subtabs, setSubtabs] = useState({
    'mapping-center': 'Stage (Unmapped)',
    'map-pricing': 'Promotions',
    'merchants': 'Merchants',
    'violations': 'All (24)',
    'email-center': 'Email History',
    'alerts': 'Active Alerts',
    'settings': 'Client Settings',
    'users-access': 'Users',
    'reports': 'Scheduled Reports'
  });

  // Dynamic databases
  const [dbState, setDbState] = useState(clientDatabases);
  const [calendarEvents, setCalendarEvents] = useState(initialCalendarEvents);

  // Active workspace references
  const clientData = dbState[selectedClient];
  const products = clientData.products;
  const violations = clientData.violations;
  const merchants = clientData.merchants;
  const promotions = clientData.promotions || [];

  // Filter States
  const [selectedMarketplace, setSelectedMarketplace] = useState('all');
  const [selectedDateRange, setSelectedDateRange] = useState('30');
  
  const [productSearch, setProductSearch] = useState('');
  const [prodCategory, setProdCategory] = useState('all');
  
  const [violationSearch, setViolationSearch] = useState('');
  const [vioSeverity, setVioSeverity] = useState('all');
  
  const [merchantSearch, setMerchantSearch] = useState('');

  // active selected indices
  const [activeViolationId, setActiveViolationId] = useState(null);
  const [activeProductId, setActiveProductId] = useState('LG001');
  const [activeMerchantName, setActiveMerchantName] = useState(null);

  // Calendar
  const [calendarYear, setCalendarYear] = useState(2026);
  const [calendarMonth, setCalendarMonth] = useState(7); // August (0-indexed)

  // Layout states
  const [mobileSidebarActive, setMobileSidebarActive] = useState(false);
  const [modals, setModals] = useState({ product: false, exception: false });
  const [toasts, setToasts] = useState([]);

  // Login inputs
  const [loginEmail, setLoginEmail] = useState('operations@mirethos.com');
  const [loginPassword, setLoginPassword] = useState('••••••••••••');
  const [isLoggingIn, setIsLoggingIn] = useState(false);

  // DOM Canvas Refs
  const violationsTimeCanvas = useRef(null);
  const severityDonutCanvas = useRef(null);
  const marketplaceBarCanvas = useRef(null);
  const productPriceCanvas = useRef(null);
  const merchantComplianceCanvas = useRef(null);

  const activeCharts = useRef({});

  // --------------------------------------------------------------------------
  // TOAST HANDLER
  // --------------------------------------------------------------------------
  const showToast = (message, type = 'success', duration = 4000) => {
    const id = Date.now();
    setToasts(prev => [...prev, { id, message, type }]);
    setTimeout(() => {
      setToasts(prev => prev.filter(t => t.id !== id));
    }, duration);
  };

  const openModal = (type) => setModals(prev => ({ ...prev, [type]: true }));
  const closeModal = (type) => setModals(prev => ({ ...prev, [type]: false }));
  const openDrawer = (id) => setActiveViolationId(id);
  const closeDrawer = () => setActiveViolationId(null);

  const navigateTo = (view) => {
    setCurrentView(view);
    setMobileSidebarActive(false);
  };

  const setSubtab = (view, tab) => {
    setSubtabs(prev => ({ ...prev, [view]: tab }));
  };

  // Sparkline generator
  const drawSparkline = (dataPoints, strokeColor) => {
    const width = 60;
    const height = 18;
    const padding = 2;
    const min = Math.min(...dataPoints);
    const max = Math.max(...dataPoints);
    const range = max - min || 1;
    
    const points = dataPoints.map((val, index) => {
      const x = padding + (index / (dataPoints.length - 1)) * (width - padding * 2);
      const y = height - padding - ((val - min) / range) * (height - padding * 2);
      return `${x},${y}`;
    }).join(' ');

    return (
      <svg className="sparkline-svg" width={width} height={height}>
        <polyline fill="none" stroke={strokeColor} strokeWidth="1.5" points={points} />
      </svg>
    );
  };

  // Calendar helpers
  const handlePrevMonth = () => {
    setCalendarMonth(prev => {
      if (prev === 0) {
        setCalendarYear(y => y - 1);
        return 11;
      }
      return prev - 1;
    });
  };

  const handleNextMonth = () => {
    setCalendarMonth(prev => {
      if (prev === 11) {
        setCalendarYear(y => y + 1);
        return 0;
      }
      return prev + 1;
    });
  };

  const getCalendarDays = () => {
    const days = [];
    const firstDayIndex = new Date(calendarYear, calendarMonth, 1).getDay();
    const totalDays = new Date(calendarYear, calendarMonth + 1, 0).getDate();

    for (let i = 0; i < firstDayIndex; i++) {
      days.push({ empty: true });
    }

    for (let day = 1; day <= totalDays; day++) {
      const dateString = `${calendarYear}-${String(calendarMonth + 1).padStart(2, '0')}-${String(day).padStart(2, '0')}`;
      const events = calendarEvents[dateString] || [];
      const isToday = day === 25 && calendarMonth === 7 && calendarYear === 2026;
      days.push({ day, isToday, events });
    }

    return days;
  };

  // --------------------------------------------------------------------------
  // CHART REBUILD & CLEANUP
  // --------------------------------------------------------------------------
  useEffect(() => {
    Object.values(activeCharts.current).forEach(c => {
      if (c) c.destroy();
    });
    activeCharts.current = {};

    if (screen !== 'app') return;

    // 1. Dashboard Violations Over Time Chart
    if (currentView === 'dashboard' && violationsTimeCanvas.current) {
      const ctx = violationsTimeCanvas.current.getContext('2d');
      const labels = Array.from({ length: 16 }, (_, i) => `${i + 10} Aug`);
      const data = selectedClient === 'LG' 
        ? [28, 30, 24, 25, 29, 32, 34, 40, 36, 31, 28, 25, 29, 35, 24, 24]
        : [15, 18, 12, 14, 19, 21, 20, 25, 22, 18, 16, 14, 18, 22, 12, 12];

      activeCharts.current.violationsTime = new Chart(ctx, {
        type: 'line',
        data: {
          labels,
          datasets: [{
            label: 'Active Violations',
            data,
            borderColor: '#9C6149',
            borderWidth: 2,
            backgroundColor: 'rgba(156, 97, 73, 0.05)',
            fill: true,
            tension: 0.3,
            pointRadius: 3,
            pointBackgroundColor: '#9C6149',
            pointBorderColor: '#FFFFFF',
            pointBorderWidth: 1.5
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { display: false } },
          scales: {
            y: {
              grid: { color: '#EFE9E0' },
              ticks: { color: '#7F7165', font: { family: 'Inter', size: 10 } }
            },
            x: {
              grid: { display: false },
              ticks: { color: '#7F7165', font: { family: 'Inter', size: 9 } }
            }
          }
        }
      });
    }

    // 2. Dashboard Severity Donut Chart
    if (currentView === 'dashboard' && severityDonutCanvas.current) {
      const ctx = severityDonutCanvas.current.getContext('2d');
      activeCharts.current.severityDonut = new Chart(ctx, {
        type: 'doughnut',
        data: {
          labels: ['Critical', 'High', 'Medium', 'Low'],
          datasets: [{
            data: selectedClient === 'LG' ? [6, 8, 7, 3] : [3, 4, 3, 2],
            backgroundColor: ['#b43a3a', '#9C6149', '#b26c15', '#7F7165'],
            borderWidth: 2,
            borderColor: '#FFFFFF'
          }]
        },
        options: {
          responsive: true,
          maintainAspectRatio: false,
          cutout: '72%',
          plugins: { legend: { display: false } }
        }
      });
    }

    // 3. Dashboard Top Violating Merchants Bar Chart
    if (currentView === 'dashboard' && marketplaceBarCanvas.current) {
      const ctx = marketplaceBarCanvas.current.getContext('2d');
      activeCharts.current.marketplaceBar = new Chart(ctx, {
        type: 'bar',
        data: {
          labels: ['XYZ Electronics (Amazon)', 'Best Buy', 'TechMart (Walmart)', 'Others'],
          datasets: [
            {
              label: 'Active Violations',
              data: selectedClient === 'LG' ? [9, 6, 5, 4] : [4, 3, 3, 2],
              backgroundColor: '#9C6149',
              borderRadius: 2,
              barThickness: 12
            }
          ]
        },
        options: {
          indexAxis: 'y',
          responsive: true,
          maintainAspectRatio: false,
          plugins: { legend: { display: false } },
          scales: {
            x: {
              grid: { color: '#EFE9E0' },
              ticks: { color: '#7F7165', font: { size: 10 } }
            },
            y: {
              grid: { display: false },
              ticks: { color: '#282524', font: { size: 10, weight: '600' } }
            }
          }
        }
      });
    }

    // 4. Product Detail Price History Chart
    if (currentView === 'product-detail' && productPriceCanvas.current) {
      const product = products.find(p => p.sku === activeProductId);
      if (product) {
        const ctx = productPriceCanvas.current.getContext('2d');
        activeCharts.current.productPrice = new Chart(ctx, {
          type: 'line',
          data: {
            labels: ['19 Aug', '20 Aug', '21 Aug', '22 Aug', '23 Aug', '24 Aug', '25 Aug'],
            datasets: [
              {
                label: 'Advertised Price',
                data: product.complianceHistory,
                borderColor: '#9C6149',
                borderWidth: 2,
                backgroundColor: 'rgba(156, 97, 73, 0.05)',
                fill: true,
                tension: 0.1
              },
              {
                label: 'MAP Floor',
                data: Array(7).fill(product.map),
                borderColor: '#7F7165',
                borderDash: [5, 5],
                borderWidth: 1.5,
                fill: false,
                pointRadius: 0
              }
            ]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { position: 'bottom', labels: { boxWidth: 10 } } },
            scales: {
              y: { grid: { color: '#EFE9E0' } },
              x: { grid: { display: false } }
            }
          }
        });
      }
    }

    // 5. Merchant Detail compliance chart
    if (currentView === 'merchant-detail' && merchantComplianceCanvas.current) {
      const merchant = merchants.find(m => m.name === activeMerchantName);
      if (merchant) {
        const ctx = merchantComplianceCanvas.current.getContext('2d');
        activeCharts.current.merchantCompliance = new Chart(ctx, {
          type: 'bar',
          data: {
            labels: ['Active Violations', 'Scanned SKUs', 'Compliant listings'],
            datasets: [{
              data: [merchant.violations, merchant.skus, Math.max(0, merchant.skus - merchant.violations)],
              backgroundColor: ['#b43a3a', '#7F7165', '#9C6149'],
              borderRadius: 2
            }]
          },
          options: {
            responsive: true,
            maintainAspectRatio: false,
            plugins: { legend: { display: false } },
            scales: {
              y: { grid: { color: '#EFE9E0' } },
              x: { grid: { display: false } }
            }
          }
        });
      }
    }

    return () => {
      Object.values(activeCharts.current).forEach(c => {
        if (c) c.destroy();
      });
      activeCharts.current = {};
    };
  }, [screen, currentView, activeProductId, activeMerchantName, selectedClient, products, violations]);

  // --------------------------------------------------------------------------
  // ACTIONS / MUTATORS
  // --------------------------------------------------------------------------
  const handleLoginSubmit = (e) => {
    e.preventDefault();
    setIsLoggingIn(true);
    setTimeout(() => {
      setIsLoggingIn(false);
      setScreen('client-select');
      showToast("Signed in as Administrator Fenil Dholakiya.", "success");
    }, 1000);
  };

  const handleSelectClient = (client) => {
    setSelectedClient(client);
    setScreen('app');
    setCurrentView('dashboard');
    showToast(`Loaded ${client} workspace parameters.`, "success");
  };

  const sendNoticeAction = () => {
    if (!activeViolationId) return;
    
    setDbState(prev => {
      const nextDb = { ...prev };
      nextDb[selectedClient].violations = nextDb[selectedClient].violations.map(v => {
        if (v.id === activeViolationId) {
          if (v.status === 'Resolved') return v;
          const nowStr = formatDate(new Date());
          const hasNotice = v.timeline.some(t => t.state === 'Notice Sent');
          const newTimeline = hasNotice ? v.timeline : [
            ...v.timeline,
            { state: 'Notice Sent', time: nowStr, desc: `Enforcement warning email dispatched successfully to ${v.merchant}.` }
          ];
          return { ...v, status: 'Notice Sent', timeline: newTimeline };
        }
        return v;
      });
      return nextDb;
    });

    showToast("Dispatched compliance warnings alert to merchant manager.", 'success');
  };

  const resolveViolationAction = () => {
    if (!activeViolationId) return;
    const target = violations.find(v => v.id === activeViolationId);
    if (!target) return;

    setDbState(prev => {
      const nextDb = { ...prev };
      const clientObj = nextDb[selectedClient];

      clientObj.violations = clientObj.violations.map(v => {
        if (v.id === activeViolationId) {
          const nowStr = formatDate(new Date());
          const newTimeline = v.timeline.some(t => t.state === 'Resolved') ? v.timeline : [
            ...v.timeline,
            { state: 'Resolved', time: nowStr, desc: 'Operator resolved discrepancy after verified price restoration.' }
          ];
          return { ...v, status: 'Resolved', timeline: newTimeline };
        }
        return v;
      });

      clientObj.products = clientObj.products.map(p => {
        if (p.sku === target.sku) {
          return { ...p, advertised: p.map, violations: 0 };
        }
        return p;
      });

      clientObj.merchants = clientObj.merchants.map(m => {
        if (m.name === target.merchant) {
          const active = Math.max(0, m.violations - 1);
          const compliance = Math.min(100, Math.round(((m.skus - active) / m.skus) * 100));
          return { ...m, violations: active, compliance };
        }
        return m;
      });

      return nextDb;
    });

    showToast('Discrepancy resolved. Pricing back to compliance.', 'success');
    closeDrawer();
  };

  const handleProductSubmit = (e) => {
    e.preventDefault();
    const data = new FormData(e.target);
    const name = data.get('name');
    const sku = data.get('sku');
    const model = data.get('model');
    const category = data.get('category');
    const map = parseFloat(data.get('map'));
    const msrp = parseFloat(data.get('msrp')) || map + 100;
    const seller = data.get('seller');

    const newProd = {
      sku,
      name,
      model,
      category,
      map,
      msrp,
      advertised: map,
      violations: 0,
      status: 'Active',
      complianceHistory: [map, map, map, map, map, map, map]
    };

    setDbState(prev => {
      const nextDb = { ...prev };
      const clientObj = nextDb[selectedClient];
      
      clientObj.products = [newProd, ...clientObj.products];
      
      const exists = clientObj.merchants.find(m => m.name === seller);
      if (exists) {
        clientObj.merchants = clientObj.merchants.map(m => m.name === seller ? { ...m, skus: m.skus + 1 } : m);
      } else {
        clientObj.merchants.push({
          name: seller, channel: 'Retailer', sellers: 1, skus: 1, violations: 0, compliance: 100, risk: 'Low', lastActive: 'Just now'
        });
      }

      return nextDb;
    });

    showToast(`SKU "${sku}" successfully registered for crawl monitors.`, 'success');
    closeModal('product');
    e.target.reset();
  };

  const handleExceptionSubmit = (e) => {
    e.preventDefault();
    const data = new FormData(e.target);
    const seller = data.get('seller');
    const scope = data.get('scope');
    const discount = parseFloat(data.get('discount'));
    const start = data.get('start');
    const end = data.get('end');

    showToast(`Promotional exception authorized for ${seller}.`, 'success');
    closeModal('exception');
    e.target.reset();
  };

  // --------------------------------------------------------------------------
  // LIST FILTERS & SORT TRANSFORMATIONS
  // --------------------------------------------------------------------------
  let filteredProducts = products.filter(p => {
    if (prodCategory !== 'all' && p.category !== prodCategory) return false;
    if (productSearch) {
      const q = productSearch.toLowerCase();
      return p.name.toLowerCase().includes(q) || p.sku.toLowerCase().includes(q) || p.model.toLowerCase().includes(q);
    }
    return true;
  });

  const filteredViolations = violations.filter(v => {
    if (vioSeverity !== 'all' && v.severity !== vioSeverity) return false;
    if (violationSearch) {
      const q = violationSearch.toLowerCase();
      return v.productName.toLowerCase().includes(q) || v.merchant.toLowerCase().includes(q) || v.id.toLowerCase().includes(q) || v.sku.toLowerCase().includes(q);
    }
    return true;
  });

  const filteredMerchants = merchants.filter(m => {
    if (merchantSearch) {
      const q = merchantSearch.toLowerCase();
      return m.name.toLowerCase().includes(q) || m.channel.toLowerCase().includes(q);
    }
    return true;
  });

  const activeViolation = violations.find(v => v.id === activeViolationId);
  const activeProduct = products.find(p => p.sku === activeProductId);
  const activeMerchant = merchants.find(m => m.name === activeMerchantName);

  // --------------------------------------------------------------------------
  // VIEW: 1. LOGIN SCREEN
  // --------------------------------------------------------------------------
  if (screen === 'login') {
    return (
      <div className="login-wrapper" style={{
        minHeight: '100vh',
        display: 'flex',
        alignItems: 'center',
        justifyContent: 'center',
        backgroundColor: '#0e1b2e',
        fontFamily: 'Inter, sans-serif'
      }}>
        <div className="card login-card" style={{
          width: '380px',
          padding: '40px 30px',
          borderRadius: '4px',
          border: '1px solid rgba(255,255,255,0.05)',
          backgroundColor: '#16253b',
          color: '#EFE9E0',
          boxShadow: '0 20px 40px rgba(0,0,0,0.3)'
        }}>
          <div style={{ display: 'flex', alignItems: 'center', gap: '10px', marginBottom: '30px', justifyContent: 'center' }}>
            <img src="/favicon.ico" alt="Mirethos Logo" style={{ width: '28px', height: '28px', backgroundColor: '#F9F6EF', padding: '2px', borderRadius: '4px' }} />
            <div>
              <h2 style={{ fontSize: '18px', fontWeight: 700, color: '#FFFFFF', letterSpacing: '0.5px' }}>MIRETHOS</h2>
              <p style={{ fontSize: '9px', textTransform: 'uppercase', letterSpacing: '1px', color: '#7F7165', marginTop: '-2px' }}>MAP Portal Login</p>
            </div>
          </div>

          <h3 style={{ fontSize: '14px', fontWeight: 600, color: '#FFFFFF', marginBottom: '5px' }}>Welcome Back</h3>
          <p style={{ fontSize: '11px', color: '#7F7165', marginBottom: '20px' }}>Enter credentials to access strategic market intelligence.</p>

          <form onSubmit={handleLoginSubmit} style={{ display: 'flex', flexDirection: 'column', gap: '15px' }}>
            <div className="form-group">
              <label className="form-label" style={{ color: '#7F7165' }}>Business Email</label>
              <input type="email" placeholder="name@company.com" value={loginEmail} onChange={e => setLoginEmail(e.target.value)} required className="form-input" style={{ backgroundColor: '#0e1b2e', border: '1px solid #7F7165', color: '#FFFFFF' }} />
            </div>

            <div className="form-group">
              <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
                <label className="form-label" style={{ color: '#7F7165' }}>Password</label>
                <a href="#" style={{ fontSize: '10px', color: '#9C6149' }} onClick={e => { e.preventDefault(); showToast("Recovery portal loaded.", "info"); }}>Forgot?</a>
              </div>
              <input type="password" placeholder="Enter your password" value={loginPassword} onChange={e => setLoginPassword(e.target.value)} required className="form-input" style={{ backgroundColor: '#0e1b2e', border: '1px solid #7F7165', color: '#FFFFFF' }} />
            </div>

            <label className="form-checkbox-label" style={{ fontSize: '11px', color: '#7F7165', display: 'flex', alignItems: 'center', gap: '8px' }}>
              <input type="checkbox" defaultChecked style={{ accentColor: '#9C6149' }} /> Remember me
            </label>

            <button type="submit" className="btn btn-primary" style={{ width: '100%', padding: '10px 0', marginTop: '10px' }} disabled={isLoggingIn}>
              {isLoggingIn ? 'Verifying...' : 'Sign In'}
            </button>
          </form>

          <div style={{ borderTop: '1px solid rgba(255,255,255,0.05)', marginTop: '25px', paddingTop: '15px', textAlign: 'center', fontSize: '10px', color: '#7F7165', display: 'flex', alignItems: 'center', justifyContent: 'center', gap: '6px' }}>
            <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
            Secured by enterprise-grade encryption
          </div>
        </div>
      </div>
    );
  }

  // --------------------------------------------------------------------------
  // VIEW: 2. CLIENT SELECTION SCREEN
  // --------------------------------------------------------------------------
  if (screen === 'client-select') {
    return (
      <div className="client-select-wrapper" style={{
        minHeight: '100vh',
        backgroundColor: '#F9F6EF',
        display: 'flex',
        flexDirection: 'column',
        alignItems: 'center',
        justifyContent: 'center',
        padding: '20px',
        fontFamily: 'Inter, sans-serif'
      }}>
        <div style={{ maxWidth: '640px', width: '100%' }}>
          <div style={{ display: 'flex', alignItems: 'center', gap: '10px', marginBottom: '40px', justifyContent: 'center' }}>
            <img src="/favicon.ico" alt="Mirethos Logo" style={{ width: '32px', height: '32px', padding: '3px', borderRadius: '4px', border: '1px solid #EFE9E0', backgroundColor: '#FFFFFF' }} />
            <div>
              <h1 style={{ fontSize: '20px', fontWeight: 700, color: '#282524' }}>MIRETHOS</h1>
              <p style={{ fontSize: '10px', textTransform: 'uppercase', letterSpacing: '1px', color: '#7F7165', marginTop: '-2px' }}>AI Market Intelligence Platform</p>
            </div>
          </div>

          <div className="card" style={{ padding: '30px', border: '1px solid #EFE9E0', backgroundColor: '#FFFFFF' }}>
            <h2 style={{ fontSize: '16px', fontWeight: 700, color: '#282524', marginBottom: '2px' }}>Select Client</h2>
            <p style={{ fontSize: '12px', color: '#7F7165', marginBottom: '25px' }}>Choose a client to access the MAP Intelligence Portal</p>

            <div style={{ display: 'grid', gridTemplateColumns: 'repeat(2, 1fr)', gap: '15px' }}>
              {Object.keys(clientDatabases).map((client) => {
                const data = clientDatabases[client];
                return (
                  <div key={client} className="card" style={{
                    padding: '20px',
                    border: '1px solid #EFE9E0',
                    borderRadius: '4px',
                    transition: 'all 0.2s ease',
                    cursor: 'pointer'
                  }}
                  onClick={() => handleSelectClient(client)}>
                    <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'flex-start', marginBottom: '15px' }}>
                      <span className={`badge ${data.statusLabel === 'Sandbox' ? 'badge-info' : 'badge-success'}`} style={{ fontSize: '8px' }}>{data.statusLabel}</span>
                      <span style={{ fontSize: '16px', fontWeight: 800, color: '#9C6149' }}>{client}</span>
                    </div>
                    <div style={{ display: 'flex', flexDirection: 'column', gap: '4px', fontSize: '11px', color: '#7F7165', marginBottom: '15px' }}>
                      <span>• SKUs Monitored: {data.products.length}</span>
                      <span>• Merchants Scanned: {data.merchants.length}</span>
                    </div>
                    <a href="#" style={{ fontSize: '11px', fontWeight: 600, color: '#9C6149', display: 'flex', alignItems: 'center', gap: '4px' }}>
                      Open Workspace &rarr;
                    </a>
                  </div>
                );
              })}
            </div>
          </div>

          <div style={{ textAlign: 'center', marginTop: '30px' }}>
            <button className="btn btn-xs btn-outline" onClick={() => setScreen('login')}>Back to Log In</button>
          </div>
        </div>
      </div>
    );
  }

  // --------------------------------------------------------------------------
  // VIEW: 3. MAIN WORKSPACE PORTAL (APP SCREEN)
  // --------------------------------------------------------------------------
  return (
    <div className="app-container">
      
      {/* SIDEBAR */}
      <aside className={`sidebar ${mobileSidebarActive ? 'active' : ''}`}>
        <div className="sidebar-brand">
          <img src="/favicon.ico" alt="Mirethos Logo" className="logo-img" />
          <div className="brand-text">
            <span className="brand-name">MIRETHOS</span>
            <span className="brand-sub">MAP Intelligence</span>
          </div>
          <button className="mobile-sidebar-close" onClick={() => setMobileSidebarActive(false)}>
            <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
          </button>
        </div>

        <div style={{ padding: '10px 20px', borderBottom: '1px solid rgba(255, 255, 255, 0.05)', backgroundColor: 'rgba(0,0,0,0.1)' }}>
          <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
            <span style={{ fontSize: '10px', color: '#7F7165', fontWeight: 600 }}>CLIENT</span>
            <button className="btn btn-xs btn-outline" style={{ color: '#FFFFFF', padding: '2px 6px', fontSize: '9px' }} onClick={() => setScreen('client-select')}>Switch</button>
          </div>
          <div style={{ fontSize: '12px', fontWeight: 700, color: '#FFFFFF', marginTop: '4px', display: 'flex', alignItems: 'center', gap: '6px' }}>
            <span style={{ width: '6px', height: '6px', borderRadius: '50%', backgroundColor: '#10b981' }}></span>
            {selectedClient} ({clientData.statusLabel})
          </div>
        </div>

        <nav className="sidebar-nav">
          <ul>
            <li>
              <a href="#" className={`nav-item ${currentView === 'dashboard' ? 'active' : ''}`} onClick={() => navigateTo('dashboard')}>
                <svg className="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><rect x="3" y="3" width="7" height="9" rx="1"/><rect x="14" y="3" width="7" height="5" rx="1"/><rect x="14" y="12" width="7" height="9" rx="1"/><rect x="3" y="16" width="7" height="5" rx="1"/></svg>
                <span>Overview</span>
              </a>
            </li>

            <li>
              <a href="#" className={`nav-item ${currentView === 'products' || currentView === 'product-detail' ? 'active' : ''}`} onClick={() => navigateTo('products')}>
                <svg className="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"/></svg>
                <span>Product Summary</span>
              </a>
            </li>

            <li>
              <a href="#" className={`nav-item ${currentView === 'mapping-center' ? 'active' : ''}`} onClick={() => navigateTo('mapping-center')}>
                <svg className="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/></svg>
                <span>Mapping Center</span>
              </a>
            </li>

            <li>
              <a href="#" className={`nav-item ${currentView === 'map-pricing' ? 'active' : ''}`} onClick={() => navigateTo('map-pricing')}>
                <svg className="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="16"/><line x1="8" y1="12" x2="16" y2="12"/></svg>
                <span>MAP & Pricing</span>
              </a>
            </li>

            <li>
              <a href="#" className={`nav-item ${currentView === 'merchants' || currentView === 'merchant-detail' ? 'active' : ''}`} onClick={() => navigateTo('merchants')}>
                <svg className="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/></svg>
                <span>Merchants (Sellers)</span>
              </a>
            </li>

            <li>
              <a href="#" className={`nav-item ${currentView === 'violations' ? 'active' : ''}`} onClick={() => navigateTo('violations')}>
                <svg className="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/></svg>
                <span className="flex-spread">
                  <span>Violations</span>
                  <span className="badge badge-error sidebar-count">24</span>
                </span>
              </a>
            </li>

            <li>
              <a href="#" className={`nav-item ${currentView === 'email-center' ? 'active' : ''}`} onClick={() => navigateTo('email-center')}>
                <svg className="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"/><path d="M22 6l-10 7L2 6"/></svg>
                <span className="flex-spread">
                  <span>Email Center</span>
                  <span className="badge badge-warning sidebar-count">14</span>
                </span>
              </a>
            </li>

            <li>
              <a href="#" className={`nav-item ${currentView === 'alerts' ? 'active' : ''}`} onClick={() => navigateTo('alerts')}>
                <svg className="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><path d="M18 8A6 6 0 0 0 6 8c0 7-3 9-3 9h18s-3-2-3-9"/><path d="M13.73 21a2 2 0 0 1-3.46 0"/></svg>
                <span>Alerts</span>
              </a>
            </li>

            <li>
              <a href="#" className={`nav-item ${currentView === 'reports' ? 'active' : ''}`} onClick={() => navigateTo('reports')}>
                <svg className="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
                <span>Reports</span>
              </a>
            </li>

            <li>
              <a href="#" className={`nav-item ${currentView === 'users-access' ? 'active' : ''}`} onClick={() => navigateTo('users-access')}>
                <svg className="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><path d="M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/><circle cx="9" cy="7" r="4"/><path d="M23 21v-2a4 4 0 0 0-3-3.87"/><path d="M16 3.13a4 4 0 0 1 0 7.75"/></svg>
                <span>Users & Access</span>
              </a>
            </li>

            <li>
              <a href="#" className={`nav-item ${currentView === 'settings' ? 'active' : ''}`} onClick={() => navigateTo('settings')}>
                <svg className="nav-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z"/></svg>
                <span>Settings</span>
              </a>
            </li>
          </ul>
        </nav>
        
        <div className="sidebar-user" style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center' }}>
          <div style={{ display: 'flex', alignItems: 'center', gap: '12px' }}>
            <div className="user-avatar" style={{ backgroundColor: '#9C6149' }}>FD</div>
            <div className="user-info">
              <span className="user-name">Fenil Dholakiya</span>
              <span className="user-role">Admin</span>
            </div>
          </div>
          <button className="btn btn-xs btn-outline" style={{ border: 'none', color: '#9C6149', fontSize: '11px' }} onClick={() => { setScreen('login'); showToast("Signed out.", "info"); }}>
            Exit
          </button>
        </div>
      </aside>

      {/* WORKSPACE */}
      <div className="workspace-container">
        
        {/* HEADER */}
        <header className="top-header">
          <div className="header-left">
            <button className="mobile-sidebar-open" onClick={() => setMobileSidebarActive(true)}>
              <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
            </button>
            <div className="breadcrumb">
              <span>{currentView === 'dashboard' ? 'Dashboard' : currentView.replace('-', ' ')}</span>
              <span className="breadcrumb-separator">-</span>
              <span>{selectedClient} ({clientData.statusLabel})</span>
            </div>
            <h1 className="page-title" style={{ textTransform: 'capitalize' }}>
              {currentView === 'dashboard' ? 'Overview' : currentView.replace('-', ' ')} - {selectedClient} ({clientData.statusLabel})
            </h1>
          </div>

          <div className="header-actions">
            <div className="last-updated">
              <span className="dot pulse"></span>
              <span>Scanner Active</span>
            </div>

            <div className="select-wrapper">
              <select className="form-select select-sm" defaultValue="Aug 10 - Aug 25, 2026">
                <option>Aug 10 - Aug 25, 2026</option>
                <option>Last 30 Days</option>
              </select>
            </div>

            <button className="btn btn-xs btn-outline">Filters</button>
          </div>
        </header>

        {/* WORKSPACE VIEW CONTENT */}
        <div className="view-content">

          {/* VIEW: DASHBOARD */}
          {currentView === 'dashboard' && (
            <div className="view-panel active">
              
              {/* Dashboard KPIs */}
              <div className="kpi-grid">
                <div className="card kpi-card">
                  <div className="kpi-header">
                    <span className="kpi-label">MAP Compliance</span>
                    <span className="trend trend-up">+2.0%</span>
                  </div>
                  <div className="kpi-value">94.2%</div>
                  <div className="kpi-footer">
                    <span className="kpi-context">vs yesterday</span>
                    {drawSparkline([92.2, 92.5, 93.0, 93.5, 94.2, 94.2], '#2c5e3b')}
                  </div>
                </div>

                <div className="card kpi-card clickable" onClick={() => navigateTo('violations')}>
                  <div className="kpi-header">
                    <span className="kpi-label">Active Violations</span>
                    <span className="trend trend-down">-3</span>
                  </div>
                  <div className="kpi-value text-red">24</div>
                  <div className="kpi-footer">
                    <span className="kpi-context">vs yesterday</span>
                    {drawSparkline([27, 28, 26, 25, 24, 24], '#b43a3a')}
                  </div>
                </div>

                <div className="card kpi-card">
                  <div className="kpi-header">
                    <span className="kpi-label">SKUs Monitored</span>
                    <span className="trend trend-neutral">+0</span>
                  </div>
                  <div className="kpi-value">10</div>
                  <div className="kpi-footer">
                    <span className="kpi-context">vs yesterday</span>
                    {drawSparkline([10, 10, 10, 10, 10, 10], '#7F7165')}
                  </div>
                </div>

                <div className="card kpi-card">
                  <div className="kpi-header">
                    <span className="kpi-label">Merchants Monitored</span>
                    <span className="trend trend-neutral">+0</span>
                  </div>
                  <div className="kpi-value">3</div>
                  <div className="kpi-footer">
                    <span className="kpi-context">vs yesterday</span>
                    {drawSparkline([3, 3, 3, 3, 3, 3], '#7F7165')}
                  </div>
                </div>

                <div className="card kpi-card">
                  <div className="kpi-header">
                    <span className="kpi-label">Total Observations (24h)</span>
                    <span className="trend trend-up">+18%</span>
                  </div>
                  <div className="kpi-value">1,248</div>
                  <div className="kpi-footer">
                    <span className="kpi-context">vs yesterday</span>
                    {drawSparkline([1050, 1100, 1150, 1200, 1248, 1248], '#2c5e3b')}
                  </div>
                </div>

                <div className="card kpi-card">
                  <div className="kpi-header">
                    <span className="kpi-label">Repeat Violators</span>
                    <span className="trend trend-neutral">+0</span>
                  </div>
                  <div className="kpi-value">2</div>
                  <div className="kpi-footer">
                    <span className="kpi-context">vs yesterday</span>
                    {drawSparkline([2, 2, 2, 2, 2, 2], '#7F7165')}
                  </div>
                </div>
              </div>

              {/* Charts Row */}
              <div className="dashboard-grid-2col">
                <div className="card chart-card">
                  <div className="card-header">
                    <div>
                      <h3 className="card-title">Violations Over Time</h3>
                      <p className="card-subtitle">Daily count of detected deviations</p>
                    </div>
                  </div>
                  <div className="chart-container">
                    <canvas ref={violationsTimeCanvas}></canvas>
                  </div>
                </div>

                <div className="dashboard-sidebar-grid">
                  <div className="card chart-card">
                    <div className="card-header">
                      <h3 className="card-title">Violations by Severity</h3>
                      <p className="card-subtitle">Distribution by deviation threshold</p>
                    </div>
                    <div className="severity-donut-wrapper">
                      <div className="chart-container-donut">
                        <canvas ref={severityDonutCanvas}></canvas>
                        <div style={{ position: 'absolute', top: '50%', left: '50%', transform: 'translate(-50%, -50%)', textAlign: 'center' }}>
                          <span style={{ fontSize: '20px', fontWeight: 800, color: '#282524', display: 'block' }}>24</span>
                          <span style={{ fontSize: '9px', color: '#7F7165', textTransform: 'uppercase' }}>Total</span>
                        </div>
                      </div>
                      <div className="severity-legend">
                        <div className="severity-legend-item">
                          <div className="legend-dot-label"><span className="legend-dot bg-red"></span><span>Critical</span></div>
                          <div><span className="legend-val">6 (25%)</span></div>
                        </div>
                        <div className="severity-legend-item">
                          <div className="legend-dot-label"><span className="legend-dot bg-terracotta"></span><span>High</span></div>
                          <div><span className="legend-val">8 (33%)</span></div>
                        </div>
                        <div className="severity-legend-item">
                          <div className="legend-dot-label"><span className="legend-dot bg-orange"></span><span>Medium</span></div>
                          <div><span className="legend-val">7 (29%)</span></div>
                        </div>
                        <div className="severity-legend-item">
                          <div className="legend-dot-label"><span className="legend-dot bg-taupe"></span><span>Low</span></div>
                          <div><span className="legend-val">3 (13%)</span></div>
                        </div>
                      </div>
                    </div>
                  </div>
                </div>
              </div>

              {/* Bar and calendar row */}
              <div className="dashboard-grid-2col margin-top">
                <div className="card">
                  <div className="card-header">
                    <div>
                      <h3 className="card-title">Top Violating Merchants</h3>
                      <p className="card-subtitle">Highest frequency risk contributors</p>
                    </div>
                  </div>
                  <div className="chart-container" style={{ height: '240px' }}>
                    <canvas ref={marketplaceBarCanvas}></canvas>
                  </div>
                </div>

                <div className="card calendar-card">
                  <div className="card-header">
                    <div>
                      <h3 className="card-title">MAP & Pricing Calendar</h3>
                      <p className="card-subtitle">Scanned event history & allowances</p>
                    </div>
                    <button className="btn btn-xs btn-outline" onClick={() => openModal('exception')}>+ Add Promo</button>
                  </div>
                  <div className="calendar-widget">
                    <div className="calendar-header-days">
                      <button className="calendar-nav-btn" onClick={handlePrevMonth}>&lt;</button>
                      <span className="calendar-month-year">{monthNames[calendarMonth]} {calendarYear}</span>
                      <button className="calendar-nav-btn" onClick={handleNextMonth}>&gt;</button>
                    </div>
                    <div className="calendar-weekdays">
                      <span>S</span><span>M</span><span>T</span><span>W</span><span>T</span><span>F</span><span>S</span>
                    </div>
                    <div className="calendar-days-grid">
                      {getCalendarDays().map((d, index) => (
                        d.empty ? (
                          <div key={index} className="calendar-day empty"></div>
                        ) : (
                          <div key={index} className={`calendar-day ${d.isToday ? 'today' : ''}`} onClick={() => {
                            if (d.events.length > 0) {
                              const details = d.events.map(ev => `• ${ev.desc}`).join('\n');
                              showToast(`Events:\n${details}`, 'success');
                            }
                          }}>
                            <span>{d.day}</span>
                            {d.events.length > 0 && (
                              <div className="calendar-day-indicators">
                                {d.events.map((ev, evIdx) => (
                                  <span key={evIdx} className={`cal-dot cal-dot-${ev.type}`}></span>
                                ))}
                              </div>
                            )}
                          </div>
                        )))}
                    </div>
                    <div className="calendar-legend" style={{ borderTop: '1px solid #EFE9E0', marginTop: '10px', paddingTop: '8px' }}>
                      <span className="legend-item"><span className="cal-dot cal-dot-violation"></span>Violation</span>
                      <span className="legend-item"><span className="cal-dot cal-dot-rule"></span>Promo Alert</span>
                      <span className="legend-item"><span className="cal-dot cal-dot-exception"></span>Expired</span>
                    </div>
                  </div>
                </div>
              </div>

              {/* Recent Critical Violations */}
              <div className="card margin-top">
                <div className="card-header">
