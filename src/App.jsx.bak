                    <button className="btn btn-xs btn-primary" onClick={() => showToast("Adding alert trigger.", "info")}>+ Add Alert Rule</button>
                  </div>
                  <div className="table-container">
                    <table className="data-table">
                      <thead>
                        <tr>
                          <th>Alert Name</th>
                          <th>Condition</th>
                          <th>Channel</th>
                          <th>Recipients</th>
                          <th>Last Triggered</th>
                          <th>Status</th>
                        </tr>
                      </thead>
                      <tbody>
                        <tr>
                          <td><strong>Critical MAP Violation</strong></td>
                          <td>Gap &gt; 15%</td>
                          <td>Email + Slack</td>
                          <td>ops-team@l-core.com</td>
                          <td>Aug 24, 2026 11:20 AM</td>
                          <td><span className="badge badge-success">Active</span></td>
                        </tr>
                      </tbody>
                    </table>
                  </div>
                </div>
              )}

              {subtabs['alerts'] !== 'Active Alerts' && (
                <div className="card">
                  <p style={{ color: '#7F7165' }}>No active entries in this tab view context.</p>
                </div>
              )}
            </div>
          )}

          {/* VIEW: REPORTS */}
          {currentView === 'reports' && (
            <div className="view-panel active">
              <div className="tab-strip" style={{ display: 'flex', gap: '2px', borderBottom: '1px solid #EFE9E0', marginBottom: '20px' }}>
                {['Scheduled Reports', 'On-demand Reports'].map(tabName => (
                  <button key={tabName} className={`tab-item ${subtabs['reports'] === tabName ? 'active' : ''}`} style={{
                    padding: '8px 16px',
                    fontSize: '12px',
                    fontWeight: 600,
                    border: 'none',
                    background: 'none',
                    borderBottom: subtabs['reports'] === tabName ? '2px solid #9C6149' : 'none',
                    color: subtabs['reports'] === tabName ? '#9C6149' : '#7F7165',
                    cursor: 'pointer'
                  }} onClick={() => setSubtab('reports', tabName)}>
                    {tabName}
                  </button>
                ))}
              </div>

              {subtabs['reports'] === 'Scheduled Reports' && (
                <div className="card">
                  <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: '15px' }}>
                    <h3 className="card-title">Reports Schedule Config</h3>
                    <button className="btn btn-xs btn-primary" onClick={() => showToast("Exporting catalog report.", "info")}>Schedule Report</button>
                  </div>
                  <div className="table-container">
                    <table className="data-table">
                      <thead>
                        <tr>
                          <th>Report Name</th>
                          <th>Frequency</th>
                          <th>Recipients</th>
                          <th>Last Run</th>
                          <th>Format</th>
                          <th>Status</th>
                        </tr>
                      </thead>
                      <tbody>
                        <tr>
                          <td><strong>Daily MAP Violations</strong></td>
                          <td>Daily</td>
                          <td>ops-team@l-core.com</td>
                          <td>Aug 25, 2026 08:00 AM</td>
                          <td>Excel</td>
                          <td><span className="badge badge-success">Active</span></td>
                        </tr>
                        <tr>
                          <td><strong>Weekly Compliance Summary</strong></td>
                          <td>Weekly</td>
                          <td>executive@l-core.com</td>
                          <td>Aug 20, 2026 09:00 AM</td>
                          <td>PDF</td>
                          <td><span className="badge badge-success">Active</span></td>
                        </tr>
                      </tbody>
                    </table>
                  </div>
                </div>
              )}

              {subtabs['reports'] !== 'Scheduled Reports' && (
                <div className="card">
                  <p style={{ color: '#7F7165' }}>No active entries in this tab view context.</p>
                </div>
              )}
            </div>
          )}

          {/* VIEW: USERS & ACCESS */}
          {currentView === 'users-access' && (
            <div className="view-panel active">
              <div className="tab-strip" style={{ display: 'flex', gap: '2px', borderBottom: '1px solid #EFE9E0', marginBottom: '20px' }}>
                {['Users', 'Roles', 'Permissions'].map(tabName => (
                  <button key={tabName} className={`tab-item ${subtabs['users-access'] === tabName ? 'active' : ''}`} style={{
                    padding: '8px 16px',
                    fontSize: '12px',
                    fontWeight: 600,
                    border: 'none',
                    background: 'none',
                    borderBottom: subtabs['users-access'] === tabName ? '2px solid #9C6149' : 'none',
                    color: subtabs['users-access'] === tabName ? '#9C6149' : '#7F7165',
                    cursor: 'pointer'
                  }} onClick={() => setSubtab('users-access', tabName)}>
                    {tabName}
                  </button>
                ))}
              </div>

              {subtabs['users-access'] === 'Users' && (
                <div className="card">
                  <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', marginBottom: '15px' }}>
                    <h3 className="card-title">User Registry and Access Logs</h3>
                    <button className="btn btn-xs btn-primary" onClick={() => showToast("Adding user invite.", "info")}>+ Invite User</button>
                  </div>
                  <div className="table-container">
                    <table className="data-table">
                      <thead>
                        <tr>
                          <th>User</th>
                          <th>Role</th>
                          <th>Access Level</th>
                          <th>Last Active</th>
                          <th>Status</th>
                        </tr>
                      </thead>
                      <tbody>
                        <tr>
                          <td><strong>Fenil Dholakiya</strong><br /><span className="text-muted font-xs">fenil.dholakiya@mirethos.com</span></td>
                          <td>Admin</td>
                          <td>Full Access</td>
                          <td>Today, 10:15 AM</td>
                          <td><span className="badge badge-success">Active</span></td>
                        </tr>
                        <tr>
                          <td><strong>Arjun Mehta</strong><br /><span className="text-muted font-xs">arjun@mirethos.com</span></td>
                          <td>Compliance Officer</td>
                          <td>MAP + Violations</td>
                          <td>Yesterday, 04:30 PM</td>
                          <td><span className="badge badge-success">Active</span></td>
                        </tr>
                      </tbody>
                    </table>
                  </div>
                </div>
              )}

              {subtabs['users-access'] !== 'Users' && (
                <div className="card">
                  <p style={{ color: '#7F7165' }}>No active entries in this tab view context.</p>
                </div>
              )}
            </div>
          )}

          {/* VIEW: SETTINGS */}
          {currentView === 'settings' && (
            <div className="view-panel active">
              <div className="tab-strip" style={{ display: 'flex', gap: '2px', borderBottom: '1px solid #EFE9E0', marginBottom: '20px' }}>
                {['Client Settings', 'Monitoring', 'MAP Rules', 'Notifications', 'Data & Execution'].map(tabName => (
                  <button key={tabName} className={`tab-item ${subtabs['settings'] === tabName ? 'active' : ''}`} style={{
                    padding: '8px 16px',
                    fontSize: '12px',
                    fontWeight: 600,
                    border: 'none',
                    background: 'none',
                    borderBottom: subtabs['settings'] === tabName ? '2px solid #9C6149' : 'none',
                    color: subtabs['settings'] === tabName ? '#9C6149' : '#7F7165',
                    cursor: 'pointer'
                  }} onClick={() => setSubtab('settings', tabName)}>
                    {tabName}
                  </button>
                ))}
              </div>

              {subtabs['settings'] === 'Client Settings' && (
                <div className="card">
                  <h3 className="card-title">Client Information Config</h3>
                  <div className="margin-top" style={{ display: 'flex', flexDirection: 'column', gap: '15px' }}>
                    <div className="form-group">
                      <label className="form-label">Client Name</label>
                      <input type="text" className="form-input text-dark" style={{ maxWidth: '300px' }} defaultValue={selectedClient} disabled />
                    </div>
                    <div className="form-group">
                      <label className="form-label">Scanner Execution Interval</label>
                      <select className="form-select" style={{ maxWidth: '200px' }} defaultValue="30">
                        <option value="15">Every 15 Minutes</option>
                        <option value="30">Every 30 Minutes</option>
                        <option value="60">Every 1 Hour</option>
                      </select>
                    </div>
                    <div className="form-group">
                      <button className="btn btn-primary" style={{ maxWidth: '150px' }} onClick={() => showToast("Settings updated.", "success")}>Save Changes</button>
                    </div>
                  </div>
                </div>
              )}

              {subtabs['settings'] !== 'Client Settings' && (
                <div className="card">
                  <p style={{ color: '#7F7165' }}>No active entries in this tab view context.</p>
                </div>
              )}
            </div>
          )}

          {/* VIEW: PRODUCT DETAIL */}
          {currentView === 'product-detail' && activeProduct && (
            <div className="view-panel active">
              <div className="back-link-row">
                <a href="#" className="back-link" onClick={(e) => { e.preventDefault(); navigateTo('products'); }}>
                  &larr; Back to Product Summary
                </a>
              </div>
              <div className="product-profile-layout margin-top">
                <div className="card product-profile-card">
                  <div className="product-profile-header">
                    <div className="product-profile-img">LG</div>
                    <div>
                      <h2 className="product-profile-name">{activeProduct.name}</h2>
                      <p className="product-profile-sku">SKU: {activeProduct.sku} | Model: {activeProduct.model}</p>
                    </div>
                  </div>
                  <div className="profile-stats-grid">
                    <div className="profile-stat">
                      <span className="profile-stat-label">MAP Price</span>
                      <span className="profile-stat-val text-dark">{formatUSD(activeProduct.map)}</span>
                    </div>
                    <div className="profile-stat">
                      <span className="profile-stat-label">MSRP</span>
                      <span className="profile-stat-val text-muted">{formatUSD(activeProduct.msrp)}</span>
                    </div>
                    <div className="profile-stat">
                      <span className="profile-stat-label">Current Price</span>
                      <span className={`profile-stat-val ${activeProduct.violations > 0 ? 'text-red' : 'text-dark'}`}>{formatUSD(activeProduct.advertised)}</span>
                    </div>
                    <div className="profile-stat">
                      <span className="profile-stat-label">Active Violations</span>
                      <span className="profile-stat-val text-red">{activeProduct.violations}</span>
                    </div>
                  </div>
                </div>

                <div className="card chart-card">
                  <div className="card-header">
                    <h3 className="card-title">Crawl Price Trajectory (7 Days)</h3>
                  </div>
                  <div className="chart-container" style={{ height: '240px' }}>
                    <canvas ref={productPriceCanvas}></canvas>
                  </div>
                </div>
              </div>
            </div>
          )}

          {/* VIEW: MERCHANT DETAIL */}
          {currentView === 'merchant-detail' && activeMerchant && (
            <div className="view-panel active">
              <div className="back-link-row">
                <a href="#" className="back-link" onClick={(e) => { e.preventDefault(); navigateTo('merchants'); }}>
                  &larr; Back to Resellers Registry
                </a>
              </div>
              <div className="product-profile-layout margin-top">
                <div className="card product-profile-card">
                  <div className="product-profile-header">
                    <div className="product-profile-img seller-avatar-styled">
                      {activeMerchant.name.substring(0, 3).toUpperCase()}
                    </div>
                    <div>
                      <h2 className="product-profile-name">{activeMerchant.name}</h2>
                      <p className="product-profile-sku">Storefront: {activeMerchant.channel}</p>
                    </div>
                  </div>
                  <div className="profile-stats-grid">
                    <div className="profile-stat">
                      <span className="profile-stat-label">SKUs Monitored</span>
                      <span className="profile-stat-val text-dark">{activeMerchant.skus}</span>
                    </div>
                    <div className="profile-stat">
                      <span className="profile-stat-label">Active Violations</span>
                      <span className="profile-stat-val text-red">{activeMerchant.violations}</span>
                    </div>
                    <div className="profile-stat">
                      <span className="profile-stat-label">Compliance Index</span>
                      <span className="profile-stat-val text-green">{activeMerchant.compliance}%</span>
                    </div>
                  </div>
                </div>

                <div className="card chart-card">
                  <div className="card-header">
                    <h3 className="card-title">Merchant Compliance Distribution</h3>
                  </div>
                  <div className="chart-container" style={{ height: '240px' }}>
                    <canvas ref={merchantComplianceCanvas}></canvas>
                  </div>
                </div>
              </div>
            </div>
          )}

        </div>
      </div>

      {/* DETAILED DRAWERS MATCHING SCREEN 11 VIOLATION DETAIL */}
      <div className={`drawer ${activeViolation ? 'active' : ''}`}>
        <div className="drawer-overlay" onClick={closeDrawer}></div>
        {activeViolation && (
          <div className="drawer-content" style={{ width: '85%', maxWidth: '1100px' }}>
            <div className="drawer-header">
              <div>
                <span className="drawer-meta" style={{ letterSpacing: '0.5px' }}>VIOLATION PROFILE</span>
                <h2 className="drawer-title" style={{ fontSize: '20px', fontWeight: 800 }}>Violation Detail - {activeViolation.id}</h2>
              </div>
              <div style={{ display: 'flex', gap: '8px', marginLeft: 'auto', marginRight: '15px' }}>
                <button className="btn btn-xs btn-outline" onClick={resolveViolationAction}>Resolve</button>
                <button className="btn btn-xs btn-outline" onClick={() => showToast("Escalated to internal policy queue.", "info")}>Escalate</button>
                <button className="btn btn-xs btn-primary" onClick={sendNoticeAction} disabled={activeViolation.status === 'Resolved'}>
                  {activeViolation.status === 'Resolved' ? 'Enforced' : 'Send Notice'}
                </button>
              </div>
              <button className="drawer-close" onClick={closeDrawer}>
                <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
              </button>
            </div>

            <div className="drawer-body" style={{ padding: '20px' }}>
              <div style={{ display: 'grid', gridTemplateColumns: '1.2fr 1.5fr 1fr', gap: '20px', alignItems: 'start' }}>
                
                {/* COLUMN 1: VIOLATION INFORMATION CARD */}
                <div className="card" style={{ padding: '16px' }}>
                  <h3 style={{ fontSize: '13px', fontWeight: 700, color: '#282524', borderBottom: '1px solid #EFE9E0', paddingBottom: '8px', marginBottom: '12px' }}>Violation Information</h3>
                  <div className="detail-list" style={{ display: 'flex', flexDirection: 'column', gap: '10px' }}>
                    <div className="detail-item" style={{ display: 'flex', justifyContent: 'space-between', fontSize: '12px' }}>
                      <span className="detail-label" style={{ color: '#7F7165' }}>SKU / Product</span>
                      <span className="detail-value text-dark" style={{ fontWeight: 600 }}>{activeViolation.sku} - {activeViolation.productName}</span>
                    </div>
                    <div className="detail-item" style={{ display: 'flex', justifyContent: 'space-between', fontSize: '12px' }}>
                      <span className="detail-label" style={{ color: '#7F7165' }}>Merchant</span>
                      <span className="detail-value text-dark" style={{ fontWeight: 600 }}>{activeViolation.merchant}</span>
                    </div>
                    <div className="detail-item" style={{ display: 'flex', justifyContent: 'space-between', fontSize: '12px' }}>
                      <span className="detail-label" style={{ color: '#7F7165' }}>Applicable Price</span>
                      <span className="detail-value text-dark" style={{ fontWeight: 600 }}>{formatUSD(activeViolation.map)}</span>
                    </div>
                    <div className="detail-item" style={{ display: 'flex', justifyContent: 'space-between', fontSize: '12px' }}>
                      <span className="detail-label" style={{ color: '#7F7165' }}>Advertised Price</span>
                      <span className="detail-value text-red" style={{ fontWeight: 600 }}>{formatUSD(activeViolation.advertised)}</span>
                    </div>
                    <div className="detail-item" style={{ display: 'flex', justifyContent: 'space-between', fontSize: '12px' }}>
                      <span className="detail-label" style={{ color: '#7F7165' }}>Gap</span>
                      <span className="detail-value text-red" style={{ fontWeight: 600 }}>{activeViolation.gap}%</span>
                    </div>
                    <div className="detail-item" style={{ display: 'flex', justifyContent: 'space-between', fontSize: '12px' }}>
                      <span className="detail-label" style={{ color: '#7F7165' }}>Detected On</span>
                      <span className="detail-value" style={{ fontWeight: 600 }}>{activeViolation.detectedOn}</span>
                    </div>
                    <div className="detail-item" style={{ display: 'flex', justifyContent: 'space-between', fontSize: '12px' }}>
                      <span className="detail-label" style={{ color: '#7F7165' }}>Severity</span>
                      <span className="badge badge-error">{activeViolation.severity}</span>
                    </div>
                  </div>
                </div>

                {/* COLUMN 2: CAPTURED SCREENSHOT EVIDENCE */}
                <div className="card" style={{ padding: '16px' }}>
                  <div style={{ display: 'flex', justifyContent: 'space-between', alignItems: 'center', borderBottom: '1px solid #EFE9E0', paddingBottom: '8px', marginBottom: '12px' }}>
                    <h3 style={{ fontSize: '13px', fontWeight: 700, color: '#282524' }}>Evidence</h3>
                    <a href={activeViolation.listingUrl} className="evidence-link" target="_blank" rel="noreferrer" style={{ fontSize: '10px', color: '#9C6149' }}>
                      View Full Screenshot &nearr;
                    </a>
                  </div>
                  <div className="mock-screenshot" style={{ height: '240px', background: '#0e1b2e', borderRadius: '4px', position: 'relative', overflow: 'hidden', padding: '10px' }}>
                    <div className="screenshot-meta" style={{ display: 'flex', justifyContent: 'space-between', fontSize: '9px', color: '#7F7165', borderBottom: '1px solid rgba(255,255,255,0.05)', paddingBottom: '4px', marginBottom: '10px' }}>
                      <span>IP: 184.28.110.15</span>
                      <span>TS: {activeViolation.detectedOn}</span>
                    </div>
                    <div style={{ display: 'flex', flexDirection: 'column', alignItems: 'center', justifyContent: 'center', height: '180px', color: '#FFFFFF' }}>
                      <span style={{ fontSize: '12px', fontWeight: 800 }}>{activeViolation.productName}</span>
                      <span style={{ fontSize: '24px', fontWeight: 900, color: '#b43a3a', margin: '10px 0' }}>{formatUSD(activeViolation.advertised)}</span>
                      <span style={{ fontSize: '9px', textTransform: 'uppercase', color: '#7F7165' }}>Sold By: {activeViolation.merchant}</span>
                    </div>
                  </div>
                </div>

                {/* COLUMN 3: TIMELINE PROGRESSION */}
                <div className="card" style={{ padding: '16px' }}>
                  <h3 style={{ fontSize: '13px', fontWeight: 700, color: '#282524', borderBottom: '1px solid #EFE9E0', paddingBottom: '8px', marginBottom: '12px' }}>Timeline</h3>
                  <div className="timeline" style={{ display: 'flex', flexDirection: 'column', gap: '15px' }}>
                    {[
                      { state: 'Detected', label: 'System crawl identified price discrepancy.' },
                      { state: 'Under Review', label: 'Assigned to policy validation queue.' },
                      { state: 'Seller Responded', label: 'Merchant submitted pricing exceptions.' },
                      { state: 'Pending Resolve', label: 'Awaiting operator final check.' }
                    ].map((step, idx) => {
                      let activeIndex = 0;
                      if (activeViolation.status === 'Under Review') activeIndex = 1;
                      if (activeViolation.status === 'Notice Sent') activeIndex = 2;
                      if (activeViolation.status === 'Resolved') activeIndex = 3;

                      const isDone = idx <= activeIndex;
                      const isCurrent = idx === activeIndex;
                      const recorded = activeViolation.timeline.find(t => t.state === step.state);

                      return (
                        <div key={idx} className={`timeline-item ${isCurrent ? 'active' : ''} ${isDone ? 'completed' : ''}`} style={{
                          display: 'flex',
                          gap: '10px',
                          position: 'relative'
                        }}>
                          <span className="timeline-dot" style={{
                            width: '8px',
                            height: '8px',
                            borderRadius: '50%',
                            backgroundColor: isDone ? '#9C6149' : '#EFE9E0',
                            marginTop: '4px',
                            zIndex: 10
                          }}></span>
                          <div style={{ display: 'flex', flexDirection: 'column' }}>
                            <span style={{ fontSize: '11px', fontWeight: 700, color: isDone ? '#282524' : '#7F7165' }}>{step.state}</span>
                            <span style={{ fontSize: '10px', color: '#7F7165' }}>{recorded ? recorded.desc : step.label}</span>
                            {recorded && <span style={{ fontSize: '8px', color: '#9C6149', marginTop: '2px' }}>{recorded.time}</span>}
                          </div>
                        </div>
                      );
                    })}
                  </div>
                </div>

              </div>
            </div>
          </div>
        )}
      </div>

      {/* ADD PRODUCT MODAL */}
      <div className={`modal ${modals.product ? 'active' : ''}`}>
        <div className="modal-overlay" onClick={() => closeModal('product')}></div>
        <div className="modal-content">
          <div className="modal-header">
            <h3 className="modal-title">Add Monitored SKU</h3>
            <button className="modal-close" onClick={() => closeModal('product')}>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
            </button>
          </div>
          <form onSubmit={handleProductSubmit}>
            <div className="modal-body">
              <div className="form-group">
                <label className="form-label">SKU Code *</label>
                <input type="text" name="sku" className="form-input" required placeholder={`e.g. ${selectedClient.toUpperCase()}006`} />
              </div>
              <div className="form-group">
                <label className="form-label">Product Name *</label>
                <input type="text" name="name" className="form-input" required placeholder="e.g. LG UltraGear Curved Monitor" />
              </div>
              <div className="form-row">
                <div className="form-group col-6">
                  <label className="form-label">Model / MPN *</label>
                  <input type="text" name="model" className="form-input" required placeholder="OLED-X-MODEL" />
                </div>
                <div className="form-group col-6">
                  <label className="form-label">Category</label>
                  <input type="text" name="category" className="form-input" defaultValue="TV" />
                </div>
              </div>
              <div className="form-row">
                <div className="form-group col-6">
                  <label className="form-label">MAP Price ($) *</label>
                  <input type="number" step="0.01" name="map" className="form-input" required placeholder="1499.00" />
                </div>
                <div className="form-group col-6">
                  <label className="form-label">MSRP ($)</label>
                  <input type="number" step="0.01" name="msrp" className="form-input" placeholder="1799.00" />
                </div>
              </div>
              <div className="form-group">
                <label className="form-label">Merchant Storefront *</label>
                <input type="text" name="seller" className="form-input" required defaultValue="XYZ Electronics (Amazon)" />
              </div>
            </div>
            <div className="modal-footer">
              <button type="button" className="btn btn-outline" onClick={() => closeModal('product')}>Cancel</button>
              <button type="submit" className="btn btn-primary">Add SKU</button>
            </div>
          </form>
        </div>
      </div>

      {/* ADD EXCEPTION MODAL */}
      <div className={`modal ${modals.exception ? 'active' : ''}`}>
        <div className="modal-overlay" onClick={() => closeModal('exception')}></div>
        <div className="modal-content">
          <div className="modal-header">
            <h3 className="modal-title">New Pricing Allowance Promotion</h3>
            <button className="modal-close" onClick={() => closeModal('exception')}>
              <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><path d="M18 6L6 18M6 6l12 12"/></svg>
            </button>
          </div>
          <form onSubmit={handleExceptionSubmit}>
            <div className="modal-body">
              <div className="form-group">
                <label className="form-label">Merchant Name *</label>
                <input type="text" name="seller" className="form-input" required placeholder="e.g. Best Buy" />
              </div>
              <div className="form-group">
                <label className="form-label">Product SKU *</label>
                <input type="text" name="scope" className="form-input" required placeholder="LG002" />
              </div>
              <div className="form-row">
                <div className="form-group col-6">
                  <label className="form-label">Allowed Promo Price ($) *</label>
                  <input type="number" step="0.01" name="discount" className="form-input" required placeholder="1699.00" />
                </div>
                <div className="form-group col-6">
                  <label className="form-label">Start Date *</label>
                  <input type="date" name="start" className="form-input" required defaultValue="2026-08-25" />
                </div>
              </div>
            </div>
            <div className="modal-footer">
              <button type="button" className="btn btn-outline" onClick={() => closeModal('exception')}>Cancel</button>
              <button type="submit" className="btn btn-primary">Create Promo</button>
            </div>
          </form>
        </div>
      </div>

      {/* TOAST alerts */}
      <div className="toast-container">
        {toasts.map(t => (
          <div key={t.id} className={`toast toast-${t.type} show`}>
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
            <div style={{ whiteSpace: 'pre-line' }}>{t.message}</div>
          </div>
        ))}
      </div>

    </div>
  );
}
