                          <td className={`text-right ${p.violations > 0 ? 'text-red' : ''}`} style={{ fontWeight: 'bold' }}>{formatUSD(p.advertised)}</td>
                          <td className={`text-center ${p.violations > 0 ? 'text-red' : ''}`} style={{ fontWeight: 'bold' }}>{p.violations}</td>
