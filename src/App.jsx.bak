                          <td className="text-right text-red" style={{ fontWeight: 'bold' }}>{formatUSD(v.advertised)}</td>
                          <td className="text-right text-red" style={{ fontWeight: 'bold' }}>{v.gap}%</td>
                          <td>{v.detectedOn}</td>
                          <td><span className="badge badge-error">{v.severity}</span></td>
                          <td className="text-center">
                            <button className="btn btn-xs btn-outline" onClick={() => openDrawer(v.id)}>Review</button>
                          </td>
                        </tr>
                      ))}
                    </tbody>
                  </table>
                </div>
              </div>

            </div>
