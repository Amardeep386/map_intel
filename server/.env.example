# Copy to server/.env and fill in. Never commit the real .env.
# Defaults below match docker-compose.yml for local development.

NODE_ENV=development
PORT=4000
# Comma-separated list of portal origins allowed to call the API (Vercel URL in production)
CORS_ORIGINS=http://localhost:5173
# The portal's address; invite links point here (the Vercel URL in production)
PORTAL_URL=http://localhost:5173

# PostgreSQL (Neon in production: use the pooled connection string with sslmode=require)
DATABASE_URL=postgres://mapintel:mapintel@localhost:5432/mapintel
# The API's own role (created by migration 002 without LOGIN; enable it with
# ALTER ROLE mapintel_api LOGIN PASSWORD '...'). Same host and database, different user.
# Required in production. Unset in development = the API uses DATABASE_URL (with a warning).
DATABASE_URL_API=
DATABASE_SSL=false

# Redis (Upstash in production: use the rediss:// URL)
REDIS_URL=redis://localhost:6379

# S3-compatible object storage (MinIO locally, AWS S3 in production)
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET=mapintel-evidence
S3_ACCESS_KEY_ID=mapintel
S3_SECRET_ACCESS_KEY=mapintel-secret
S3_FORCE_PATH_STYLE=true
# Days to lock evidence objects (Governance mode). The mapintel-evidence bucket has Object Lock
# enabled (27 Sep 2026); use 365 wherever evidence is written. 0 = no lock (local MinIO only):
# the worker refuses to start in production without a lock.
S3_OBJECT_LOCK_DAYS=365

# Auth: long random string (e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`)
JWT_SECRET=change-me-to-a-long-random-string
JWT_TTL_HOURS=12
# MFA (Phase 5): 32-byte base64 key that seals authenticator secrets, e.g. `openssl rand -base64 32`.
# Set it in production: without it the key is derived from JWT_SECRET, and changing JWT_SECRET
# would make every user set MFA up again.
MFA_KEY=
# true = every Mirethos platform administrator must use MFA.
PLATFORM_MFA_REQUIRED=false

# Sign in with Google (Phase 5). The button appears on the sign-in page only when both values are set.
# Register this redirect URI with Google: <API_PUBLIC_URL>/auth/sso/google/callback
API_PUBLIC_URL=http://localhost:4000
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Credential vault (source logins, SFTP/Slack delivery credentials), encrypted with AES-256-GCM.
# Generate a key: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# VAULT_KEYS lists every key still needed to decrypt (id:key,id:key); VAULT_ACTIVE_KEY encrypts new secrets.
VAULT_KEYS=
VAULT_ACTIVE_KEY=

# First admin user created by `npm run db:seed` (password: at least 12 characters).
# To change the password later, edit SEED_ADMIN_PASSWORD and run `npm run admin:set-password`.
SEED_ADMIN_EMAIL=operations@mirethos.com
SEED_ADMIN_PASSWORD=change-me-now
SEED_ADMIN_NAME=Mirethos Operations

# Collector
# Minimum delay between two requests to the same retailer host (ms), plus random jitter
COLLECT_MIN_DELAY_MS=15000
COLLECT_JITTER_MS=5000
# Respect robots.txt (keep true until the legal review says otherwise)
COLLECT_RESPECT_ROBOTS=true
# Use a headless browser when the plain HTTP request is blocked or incomplete
COLLECT_BROWSER_FALLBACK=true
# Label for where requests come from (retailers show different prices/stock by country)
COLLECT_EGRESS_LABEL=local
# Optional: Best Buy Products API key. When set, Best Buy price/stock comes from the API.
BESTBUY_API_KEY=
# Optional: eBay Browse API (developer.ebay.com, client credentials). Enables eBay keyword search.
EBAY_CLIENT_ID=
EBAY_CLIENT_SECRET=
# eBay Marketplace Account Deletion endpoint (API host only): token and the exact URL entered on developer.ebay.com
EBAY_VERIFICATION_TOKEN=
EBAY_DELETION_ENDPOINT=
# Optional: route all collector traffic (fetch, robots.txt, browser) through a US proxy.
# http://user:pass@host:port
COLLECT_HTTPS_PROXY=
# Worker: jobs at a time per source queue (keep 1 on a 512 MB instance with headless pages).
COLLECT_CONCURRENCY=1
# How often the scheduler looks for due schedules (minutes).
SCHEDULER_TICK_MINUTES=5

# Email (P3). Unset or 'log' = emails are only written to the notification log (no provider yet).
# MAIL_PROVIDER=log
