{
  "name": "map-intel-server",
  "private": true,
  "version": "0.1.0",
  "description": "Mirethos MAP Intel backend: API, collector worker, database migrations",
  "type": "module",
  "engines": {
    "node": ">=20.11"
  },
  "scripts": {
    "dev": "tsx watch src/api/index.ts",
    "dev:worker": "tsx watch src/worker/index.ts",
    "start": "node dist/api/index.js",
    "start:worker": "node dist/worker/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test test/*.test.ts",
    "test:db": "tsx --test --test-concurrency=1 test/db/*.test.ts",
    "db:migrate": "tsx src/scripts/migrate.ts",
    "db:seed": "tsx src/scripts/seed.ts",
    "admin:set-password": "tsx src/scripts/set-admin-password.ts",
    "exit:p1": "tsx src/scripts/exit-p1.ts",
    "storage:init": "tsx src/scripts/storage-init.ts",
    "collect": "tsx src/scripts/collect.ts",
    "collect:report": "tsx src/scripts/report.ts",
    "browsers:install": "playwright install chromium",
    "sellers:backfill": "tsx src/scripts/backfill-sellers.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.700.0",
    "@aws-sdk/s3-request-presigner": "^3.700.0",
    "@fastify/cors": "^11.0.0",
    "bcryptjs": "^3.0.2",
    "bullmq": "^5.34.0",
    "cheerio": "^1.1.0",
    "cron-parser": "4.9.0",
    "dotenv": "^17.2.0",
    "exceljs": "^4.4.0",
    "fastify": "^5.2.0",
    "ioredis": "^5.4.2",
    "jose": "^6.0.0",
    "pg": "^8.13.1",
    "playwright": "1.56.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  },
  "overrides": {
    "uuid": "^11.1.1"
  }
}
